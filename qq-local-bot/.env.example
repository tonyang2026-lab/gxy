# 默认仅本地测试，不向QQ发消息。实际接入准备好后才改为 true。
QQ_LIVE=false
# 与平台接入方式一致；WebSocket不需要公网回调。
QQ_TRANSPORT=websocket
QQ_APP_ID=
QQ_APP_SECRET=
# 如平台单独提供回调验签 Secret 可在此填写；空值时使用 AppSecret。
QQ_WEBHOOK_SECRET=
# 使用真实回调中的group_openid，不是QQ群号码；空值时不回复任何群。
# 多个值用英文逗号分隔；明确要回复所有已授权添加的群时可填写 *。
QQ_ALLOWED_GROUPS=
QQ_SANDBOX=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# 机器人名字
BOT_NAME=独角兽
# 可选昵称，英文逗号分隔，最多5个。
BOT_ALIASES=
# 可选，供本地“值得回复”测试进行话题筛选；空值表示不限定话题。
BOT_TOPICS=
PORT=3939
