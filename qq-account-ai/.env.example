# NapCat的正向WebSocket服务，只开放本机。令牌须至少16字符，两边一致。
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_TOKEN=
# 允许回复的QQ群号/好友QQ号，英文逗号分隔。留空则不回复。
ALLOWED_GROUPS=
ALLOWED_USERS=
# 群里未@、没叫独角兽时，是否结合最近群聊判断插话（60秒冷却，每10分钟最多3次）。
GROUP_AUTO_REPLY=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# AI新闻：开启后每小时检查一次，每个群每次最多5条新新闻，首次等1小时。
NEWS_ENABLED=false
# 仅填写明确授权推送的QQ群号，且必须在ALLOWED_GROUPS中。
NEWS_GROUPS=
# 闲聊速度参数：输出上限为token数，并非中文字数；过低可能截断回答。
REPLY_MAX_TOKENS=160
OLLAMA_NUM_CTX=3072
